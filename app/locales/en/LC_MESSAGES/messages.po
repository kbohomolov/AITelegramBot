msgstr "🗑 Delete account"

msgid "confirm_delete"
msgstr "✅ Yes, delete"

msgid "cancel"
msgstr "❌ Cancel"

msgid "delete_confirm"
msgstr ""
"⚠️ <b>Account deletion confirmation</b>\n\n"
"Are you sure you want to delete your account?\n\n"
"All user data will be deleted, including settings and interaction history.\n\n"
"Please choose an action below."

msgid "delete_success"
msgstr ""
"✅ <b>Account successfully deleted</b>\n\n"
"All data has been removed from the system.\n\n"
"To use the bot again, you need to re-register using the /start command."

msgid "language_current"
msgstr "🌎 <b>Current language:</b> {language}\n\nSelect a new interface language:"

msgid "ukrainian"
msgstr "🇺🇦 Ukrainian"

msgid "english"
msgstr "🇬🇧 English"

msgid "account_deleted"
msgstr ""
"Your account has been deleted.\n"
"To register again, use the /start command"

msgid "no_answer_found"
msgstr ""
"❗ <b>Answer not found</b>\n\n"
"Unfortunately, the system could not find relevant information in the knowledge base.\n\n"
"<b>Recommendations:</b>\n"
"• try rephrasing your request;\n"
"• use keywords;\n"
"• clarify the context of the question.\n\n"
"This will help to get a more accurate answer."